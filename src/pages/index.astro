---
const galleries = [
  { id: 'bridal', title: 'Bridal', image: 'bridal-portrait', alt: 'Bride in an elegant ivory gown standing in a historic interior' },
  { id: 'family', title: 'Family', image: 'family-castle', alt: 'Multigenerational family laughing together in a castle garden' },
  { id: 'grad', title: 'Grad', image: 'grad-campus', alt: 'Graduate in cap and gown at golden hour' },
  { id: 'event', title: 'Event', image: 'event-gala', alt: 'Formal gala in a candlelit ballroom' },
];

const featured = [
  { image: 'bridal-steps', alt: 'Newlyweds walking down broad stone steps', className: 'wide' },
  { image: 'bridal-portrait', alt: 'Bride in an elegant ivory gown standing in a historic interior', className: 'tall' },
  { image: 'family-castle', alt: 'Multigenerational family laughing together in a castle garden', className: 'wide' },
  { image: 'grad-campus', alt: 'Graduate in cap and gown at golden hour', className: 'tall' },
  { image: 'event-gala', alt: 'Formal gala in a candlelit ballroom', className: 'wide' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Kelly Insinga Photography — timeless bridal, family, graduation, and event photography." />
    <title>Kelly Insinga Photography</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Montserrat:wght@300;400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="Kelly Insinga Photography home">
        <span>Kelly Insinga</span>
        <small>Photography</small>
      </a>
      <nav class="desktop-nav" aria-label="Primary navigation">
        <a href="#featured">Featured</a>
        <a href="#about">About</a>
        <a href="#contact">Inquire</a>
      </nav>
      <button class="menu-button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open gallery menu">
        <span></span><span></span><span></span>
      </button>
      <nav id="mobile-menu" class="mobile-menu" aria-label="Gallery navigation" hidden>
        <p>Galleries</p>
        {galleries.map((gallery) => <a href={`#${gallery.id}`}>{gallery.title}</a>)}
        <a href="#about">About</a>
        <a href="#contact">Inquire</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero">
        <picture>
          <source type="image/webp" srcset="/images/bridal-steps-960.webp 960w, /images/bridal-steps-1600.webp 1600w" sizes="100vw" />
          <img src="/images/bridal-steps-1600.webp" alt="Newlyweds walking down broad stone steps" fetchpriority="high" />
        </picture>
        <div class="hero-shade"></div>
        <div class="hero-copy">
          <p class="eyebrow">Fine art photography</p>
          <h1>Life, held<br /><em>beautifully.</em></h1>
          <p>Honest moments preserved with warmth, grace, and a touch of grandeur.</p>
          <a class="button" href="#featured">View the portfolio</a>
        </div>
      </section>

      <section class="intro" id="about">
        <p class="eyebrow">Columbus, Ohio & beyond</p>
        <h2>Photographs that feel<br />like <em>heirlooms</em></h2>
        <p class="lede">Refined storytelling for the days you never want to forget. Kelly creates luminous, artful images rooted in genuine connection.</p>
        <div class="ornament" aria-hidden="true">✦</div>
      </section>

      <section class="featured" id="featured">
        <div class="section-heading">
          <p class="eyebrow">The best of the best</p>
          <h2>Featured work</h2>
        </div>
        <div class="masonry">
          {featured.map((item) => (
            <figure class={item.className}>
              <picture>
                <source type="image/webp" srcset={`/images/${item.image}-960.webp 960w, /images/${item.image}-1600.webp 1600w`} sizes="(max-width: 700px) 100vw, 50vw" />
                <img src={`/images/${item.image}-1600.webp`} alt={item.alt} loading="lazy" />
              </picture>
            </figure>
          ))}
        </div>
      </section>

      <section class="collections" aria-labelledby="collections-title">
        <div class="section-heading">
          <p class="eyebrow">Every chapter</p>
          <h2 id="collections-title">The collections</h2>
        </div>
        <div class="collection-grid">
          {galleries.map((gallery) => (
            <article id={gallery.id} class="collection-card">
              <picture>
                <source type="image/webp" srcset={`/images/${gallery.image}-960.webp 960w, /images/${gallery.image}-1600.webp 1600w`} sizes="(max-width: 700px) 100vw, 25vw" />
                <img src={`/images/${gallery.image}-1600.webp`} alt={gallery.alt} loading="lazy" />
              </picture>
              <div><span>{gallery.title}</span><small>View gallery</small></div>
            </article>
          ))}
        </div>
      </section>

      <section class="contact" id="contact">
        <p class="eyebrow">Begin your story</p>
        <h2>Let’s make something<br /><em>timeless.</em></h2>
        <a class="button light" href="mailto:hello@example.com">Inquire with Kelly</a>
        <p class="placeholder-note">Contact address is a placeholder and should be replaced before launch.</p>
      </section>
    </main>

    <footer>
      <div class="brand"><span>Kelly Insinga</span><small>Photography</small></div>
      <p>Bridal · Family · Grad · Event</p>
      <p>© {new Date().getFullYear()} Kelly Insinga Photography</p>
    </footer>
    <script>
      const button = document.querySelector('.menu-button');
      const menu = document.querySelector('#mobile-menu');
      button?.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!open));
        if (menu instanceof HTMLElement) menu.hidden = open;
      });
      menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        button?.setAttribute('aria-expanded', 'false');
        if (menu instanceof HTMLElement) menu.hidden = true;
      }));
    </script>
  </body>
</html>
